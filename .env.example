# Copy to .env and fill in. Never commit .env.
# Neon connection string: Vercel → project → Storage → Neon → .env.local tab
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Any long random string, e.g. the output of: openssl rand -hex 32
PAYLOAD_SECRET=
# Image uploads in production. Vercel adds this when a Blob store is connected; leave empty locally.
BLOB_READ_WRITE_TOKEN=
# Only for `npm run seed`: your own Neon branch's host, never production. The script tells you the value.
SEED_DATABASE_HOST=
